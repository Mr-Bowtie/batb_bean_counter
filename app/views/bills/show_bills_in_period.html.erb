<div class="container mx-2">
  <% content_for :title, "Bills in period" %>

  <p class="has-text-centered subtitle is-4">Remaining Due This Period: <span class="has-text-danger"><%= currencyDecorator(@period_balance) %></span></p>
  <div id="bills" class="grid mt-4">
    <% @bill_records.sort_by(&:date).each do |bill_record| %>
      <div class="cell bill-record">
        <%= render bill_record %>
      </div>
    <% end %>
  </div>

  <%= link_to "Back to all Bills",bills_path, class: "button is-warning is-outlined mt-6" %>


</div>

