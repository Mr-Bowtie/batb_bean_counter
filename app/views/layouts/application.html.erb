<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bean Counter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="container">

    <div class="pt-4 pb-6">
      <div class="is-flex is-align-items-center mb-2">
        <%= form_with url: '/show_bills_in_period', method: :get do |form| %>
          <div class="is-flex is-align-items-end is-justify-content-space-between">
            <div class="field mr-2">
              <%= form.label "Start", class: "label" %>
              <div class="control">
                <%= form.date_field :start_date, class: "input is-warning is-outlined" %>
              </div>
            </div>
            <div class="field mr-4">
              <%= form.label "End", class: "label" %>
              <div class="control">
                <%= form.date_field :end_date, class: "input is-warning is-outlined" %>
              </div>
            </div>

            <div class="has-text-centered">
              <%= form.submit "submit", class: "button is-primary is-outlined" %>
            </div>
          </div>
        <% end %>

        <h1 class="title is-1 fixed-center-title-20">
          <%= content_for :title %>
        </h1>

        <div class="ml-auto">
          <%= link_to "New bill", new_bill_path, class: "button is-info" %>
        </div>
      </div>

      <p class="has-text-danger"><%= alert %></p>
      <p style="color: green"><%= notice %></p>
    </div>
    <%= yield %>
  </body>
</html>
