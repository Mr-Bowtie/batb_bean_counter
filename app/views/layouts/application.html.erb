<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Bean Counter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="container">
    <nav class="navbar mt-4" data-controller="navbar">
      <div class="navbar-brand title is-1">
        <%= link_to "Bean Counter", bills_path, class: "is-size-1" %>
        <a
          role="button"
          class="navbar-burger"
          aria-label="menu"
          aria-expanded="false"
          data-action='click->navbar#toggleMenu'
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </a>
      </div>
      <div class="navbar-menu" data-navbar-target="menu">
        <div class="navbar-start ml-4">
          <div class="navbar-item nav-menu-item">
            <%= link_to "Pay Periods",
            pay_period_breakdowns_path,
            class: "navbar-item is-size-4" %>
          </div>
        </div>
        <div class="navbar-end">
          <div class="ml-auto nav-menu-item">
            <%= link_to "New bill", new_bill_path, class: "button is-info" %>
          </div>

          <div class="ml-2 nav-menu-item">
            <%= link_to "New Pay Period", new_pay_period_breakdown_path, class: "button is-link" %>
          </div>
        </div>

      </div>
    </nav>

    <div class="pt-4 pb-6">
      <div class="is-flex is-align-items-center mb-2">
        <%= form_with url: '/show_bills_in_period', method: :get do |form| %>
          <div class="is-flex is-align-items-end is-justify-content-space-between">
            <div class="field mr-2">
              <%= form.label "Start", class: "label" %>
              <div class="control">
                <%= form.date_field :start_date, class: "input is-warning is-outlined" %>
              </div>
            </div>
            <div class="field mr-4">
              <%= form.label "End", class: "label" %>
              <div class="control">
                <%= form.date_field :end_date, class: "input is-warning is-outlined" %>
              </div>
            </div>

            <div class="has-text-centered">
              <%= form.submit "submit", class: "button is-primary is-outlined" %>
            </div>
          </div>
        <% end %>

      </div>

      <% if alert.present? %>
        <div class="notification is-danger">
          <%= alert %>
        </div>
      <% end %>
      <% if notice.present? %>
        <div class="notification is-success is-light">
          <%= notice %>
        </div>
      <% end %>
    </div>
    <%= yield %>
  </body>
</html>
