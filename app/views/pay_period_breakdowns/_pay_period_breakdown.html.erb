<div id="<%= dom_id pay_period_breakdown %>">
  <p>
    <strong>Paycheck amount:</strong>
    <%= pay_period_breakdown.paycheck_amount %>
  </p>

  <p>
    <strong>Pay date:</strong>
    <%= pay_period_breakdown.pay_date %>
  </p>

  <p>
    <strong>Next pay date:</strong>
    <%= pay_period_breakdown.next_pay_date %>
  </p>

  <p>
    <strong>Pay frequency:</strong>
    <%= pay_period_breakdown.pay_frequency %>
  </p>

</div>
