<div class="container mx-2">
  <% content_for :title, "Pay period breakdown" %>

  <section class="box">
    <%= render @pay_period_breakdown %>

    <div class="buttons is-centered mt-4">
      <%= link_to "Edit", edit_pay_period_breakdown_path(@pay_period_breakdown), class: "button is-warning is-outlined" %>
      <%= link_to "Back to list", pay_period_breakdowns_path, class: "button is-light" %>
      <%= button_to "Delete", @pay_period_breakdown, method: :delete, data: { turbo_confirm: "Delete this breakdown?" }, class: "button is-danger is-outlined" %>
    </div>
  </section>

  <section class="mt-6">
    <h2 class="title is-4 has-text-centered">Bills in this pay period</h2>
    <p class="has-text-centered subtitle is-5">
      Remaining Due: <span class="has-text-danger">$<%= currencyDecorator(@remaining_bill_total_cents) %></span> / <span>$<%= currencyDecorator(@pay_period_breakdown.bill_total) %></span>
    </p>

    <% if @bill_records.any? %>
      <div id="bill-records" class="grid mt-4">
        <% @bill_records.sort_by(&:date).each do |bill_record| %>
          <div class="cell bill-record <%= bill_record.every_check? ? "every-check" : "" %>">
            <%= render bill_record, return_to: pay_period_breakdown_path(@pay_period_breakdown) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="has-text-centered has-text-grey">No bills matched this pay period yet.</p>
    <% end %>
  </section>

  <section class="mt-6">
    <h2 class="title is-4 has-text-centered">Distributables</h2>
    <div class="grid mt-4">
      <%= allocation_tile("Total leftover", @calculation[:leftover_funds], color_class: "has-text-success") %>
      <%= allocation_tile("Credit Card Funds (#{@calculation[:credit_card_allocation_pct]}%)", @calculation[:credit_card_funds]) %>
      <%= allocation_tile("Individual Funds (#{@calculation[:individual_allocation_pct]}% split)", @calculation[:individual_funds], color_class: "has-text-warning") %>
    </div>
    <p class="has-text-centered has-text-grey mt-2 is-size-6">
      Individual funds represent the per-person amount after splitting the configured percentage.
    </p>
  </section>
</div>
