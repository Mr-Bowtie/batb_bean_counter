<%= form_with(model: pay_period_breakdown) do |form| %>
  <% if pay_period_breakdown.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(pay_period_breakdown.errors.count, "error") %> prohibited this pay_period_breakdown from being saved:</h2>

      <ul>
        <% pay_period_breakdown.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :paycheck_amount, style: "display: block" %>
    <%= form.number_field :paycheck_amount %>
  </div>

  <div>
    <%= form.label :pay_date, style: "display: block" %>
    <%= form.date_field :pay_date %>
  </div>

  <div>
    <%= form.label :pay_frequency, style: "display: block" %>
    <%= form.number_field :pay_frequency %>
    <p style="font-size: 0.9em; color: #555;">Enter the number of days between paychecks.</p>
  </div>

  <% if pay_period_breakdown.next_pay_date.present? %>
    <p>
      Next pay date will be calculated as <strong><%= pay_period_breakdown.next_pay_date %></strong>.
    </p>
  <% else %>
    <p>Next pay date will be calculated automatically once pay date and frequency are provided.</p>
  <% end %>

  <div>
    <%= form.submit %>
  </div>
<% end %>
