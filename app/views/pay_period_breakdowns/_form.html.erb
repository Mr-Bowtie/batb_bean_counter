<div class="container is-flex is-flex-direction-column is-align-items-center">
  <%= form_with(model: pay_period_breakdown, class: "pay-period-form") do |form| %>
    <% if pay_period_breakdown.errors.any? %>
      <div class="notification is-danger is-light">
        <h2 class="title is-5"><%= pluralize(pay_period_breakdown.errors.count, "error") %> prevented saving:</h2>
        <ul>
          <% pay_period_breakdown.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field mt-4">
      <%= form.label :paycheck_amount, class: "label" %>
      <div class="control">
        <%= form.text_field :paycheck_amount, value: currencyDecorator(pay_period_breakdown.paycheck_amount), class: "input" %>
      </div>
    </div>

    <div class="mt-5"
         data-controller="allocation-form"
         data-allocation-form-index-value="<%= pay_period_breakdown.pay_period_allocations.size %>">
      <div class="is-flex is-justify-content-space-between is-align-items-center">
        <div>
          <p class="label mb-1">Allocations</p>
          <p class="help">Labels and percentages are fully editable. All active allocations must total exactly 100%.</p>
        </div>
        <button type="button"
                class="button is-link is-light is-small"
                data-action="allocation-form#addAllocation">
          Add Allocation
        </button>
      </div>

      <p class="has-text-weight-semibold mt-3">
        Current total:
        <span data-allocation-form-target="total"></span>
      </p>

      <div data-allocation-form-target="container">
        <%= form.fields_for :pay_period_allocations do |allocation_fields| %>
          <%= render "allocation_fields", form: allocation_fields %>
        <% end %>
      </div>

      <template data-allocation-form-target="template">
        <%= form.fields_for :pay_period_allocations, PayPeriodAllocation.new, child_index: "NEW_RECORD" do |allocation_fields| %>
          <%= render "allocation_fields", form: allocation_fields %>
        <% end %>
      </template>
    </div>

    <div class="field mt-4">
      <%= form.label :pay_date, class: "label" %>
      <div class="control">
        <%= form.date_field :pay_date, class: "input" %>
      </div>
    </div>

    <div class="field mt-4">
      <%= form.label :pay_frequency, class: "label" %>
      <div class="control">
        <%= form.number_field :pay_frequency, class: "input", min: 1, step: 1 %>
      </div>
      <p class="help">Number of days until the next paycheck.</p>
    </div>

    <div class="notification is-info is-light mt-4">
      Next pay date is automatically calculated once the pay date and frequency are set.
      <% if pay_period_breakdown.next_pay_date.present? %>
        Current value: <strong><%= pay_period_breakdown.next_pay_date %></strong>
      <% end %>
    </div>

    <div class="has-text-centered mt-4">
      <%= form.submit pay_period_breakdown.persisted? ? "Update Pay Period" : "Create Pay Period", class: "button is-primary is-outlined" %>
    </div>
  <% end %>
</div>
