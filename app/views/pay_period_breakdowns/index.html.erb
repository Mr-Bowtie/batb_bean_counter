<div class="mx-2">
  <% content_for :title, "Pay period breakdowns" %>

  <h1 class="title is-1 mb-6 has-text-centered">Pay Periods</h1>

  <% if @pay_period_breakdowns.any? %>
    <div id="pay_period_breakdowns" class="grid mt-4">
      <% @pay_period_breakdowns.order(pay_date: :desc).each do |pay_period_breakdown| %>
        <div class="cell pay-period-breakdown">
          <%= render pay_period_breakdown %>
          <p class="has-text-centered mt-3">
            <%= link_to "View details", pay_period_breakdown, class: "button is-link is-light is-small" %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="has-text-centered has-text-grey mt-6">No pay period breakdowns yet.</p>
  <% end %>
</div>
