<div id="<%= dom_id bill_record %>">
  <p class="has-text-centered title is-4">
    <%= bill_record.bill.name %>
  </p>
  <p class="has-text-centered mt-2">
    <%= bill_record.date %>
  </p>

  <p class="has-text-centered mt-2">
    <strong class="has-text-info"><%= bill_record.bill.payment_source.name %></strong>
  </p>

  <%= form_with model: bill_record, method: :patch, class: "mt-4" do |form| %>
    <%= form.hidden_field :return_to, value: local_assigns[:return_to] %>

    <div class="field">
      <%= form.label :amount, class: "label has-text-centered" %>
      <div class="control">
        <%= form.text_field :amount, value: currencyDecorator(bill_record.amount), class: "input has-text-centered" %>
      </div>
    </div>

    <div class="field">
      <div class="control is-flex is-align-items-center is-justify-content-center">
        <%= form.label :paid, "Paid", class: "mr-2" %>
        <%= form.check_box :paid, class: "ml-2" %>
      </div>
    </div>

    <div class="has-text-centered">
      <%= form.submit "Save", class: "button is-info is-outlined" %>
    </div>
  <% end %>
</div>
