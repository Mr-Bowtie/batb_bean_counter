<div id="<%= dom_id bill_record %>">
  <p class="has-text-centered title is-4">
    <%= bill_record.bill.name %>
  </p>
  <p class="has-text-centered mt-2">
    <%= bill_record.date %>
  </p>
  <div class="is-flex is-align-items-center is-justify-content-center">
    <p class="has-text-centered">Paid :
    </p>
    <%= form_with url: bill_record_path(bill_record), method: :patch, local: true, class: "is-flex is-flex-direction-column is-align-items-center" do |form| %>
      <%= form.check_box :paid,
                     { onchange: "this.form.submit();", checked: bill_record.paid, class: "ml-2" } %>
    <% end %>
  </div>
  <p class="has-text-centered has-text-danger subtitle is-5">
    $<%= currencyDecorator(bill_record.bill.amount) %>
  </p>
</div>
