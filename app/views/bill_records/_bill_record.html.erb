<div id="<%= dom_id bill_record %>" data-controller="bill-record-form">
  <p class="has-text-centered title is-4">
    <%= bill_record.display_name %>
  </p>
  <p class="has-text-centered mt-2">
    <%= bill_record.date %>
  </p>

  <p class="has-text-centered mt-2">
    <strong class="has-text-info"><%= bill_record.source_name %></strong>
  </p>

  <p class="has-text-centered has-text-danger subtitle is-5 mt-3">
    $<%= currencyDecorator(bill_record.amount) %>
  </p>

  <p class="has-text-centered mt-2">
    Status:
    <strong><%= bill_record.paid? ? "Paid" : "Due" %></strong>
  </p>

  <div class="has-text-centered mt-3">
    <button type="button"
            class="button is-info is-light is-small"
            data-bill-record-form-target="toggleButton"
            data-action="bill-record-form#toggle">
      Edit
    </button>
  </div>

  <div class="mt-4 is-hidden" data-bill-record-form-target="panel">
    <%= render "bill_records/form",
               bill_record: bill_record,
               form_url: bill_record_path(bill_record),
               form_method: :patch,
               return_to: local_assigns[:return_to],
               submit_label: "Save Changes",
               form_class: "mt-2" %>
  </div>
</div>
