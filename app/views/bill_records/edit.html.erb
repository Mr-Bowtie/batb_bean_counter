<% content_for :title, "Editing Bill Record" %>

<div class="container">
  <h1 class="title is-1">Editing Bill Record</h1>

  <div class="container is-flex is-flex-direction-column is-align-items-center">
    <%= render "form",
               bill_record: @bill_record,
               form_url: bill_record_path(@bill_record),
               form_method: :patch,
               return_to: request.referer,
               submit_label: "Save Changes",
               form_class: "mt-4 width-full" %>
  </div>
</div>
